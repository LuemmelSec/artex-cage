# The installer copies this file to .env and generates a database password.
# Compose reads .env. Examples below are comments; replace values in .env to
# use them. If copying manually, set a strong, unique POSTGRES_PASSWORD.

# Example: America/New_York
TZ=Europe/Berlin

POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# --- model ----------------------------------------------------------------- #
# Configure these in the ARTEX UI or in .env. Replace all example values.
# API key, if required by your provider. Example: your-api-key
OPENAI_API_KEY=
# Example for an OpenAI-compatible server: openai
ARTEX_LLM_PROVIDER=
# Model identifier as reported by your provider. Example: your-model-id
ARTEX_LLM_MODEL=
# Example: http://192.168.1.10:1234/v1
ARTEX_LLM_BASE_URL=
# Private model-list endpoints: comma-separated exact host:port entries, without
# a scheme or path. Example: 192.168.1.10:1234,model.local:1234
# Alternatively, use sudo ./install.sh --allow-model HOST:PORT.
# An endpoint also needs a separate egress approval in the console.
ARTEX_LLM_PRIVATE_ENDPOINTS=

# --- safety rails ----------------------------------------------------------- #
# Prompt-injection boundary, on by default. Set to 0 only if you know why.
# ARTEX_UNTRUSTED_BOUNDARY=0

# Request pacing against targets: off (default) | quiet | balanced | aggressive.
# ARTEX_NOISE_PROFILE=balanced

# Hard token ceilings per task and per worker run. Unset = unlimited.
# ARTEX_TASK_BUDGET_TOKENS=2000000
# ARTEX_INTENT_BUDGET_TOKENS=400000

# Optional fixed key for secrets at rest. Empty = keys/secret.key, generated
# on first start. Losing it loses the encrypted secrets.
# ARTEX_SECRET_KEY=
